<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CKN.Sdk.Network.Http</PackageId>
    <Description>HttpClient-based provider for CKN.Sdk.Network. Provides resilience (retry, circuit breaker), client-side rate limiting, authentication strategies, and sensitive-parameter masking via Microsoft.Extensions.Http.Resilience.</Description>
    <PackageTags>ckn;sdk;http;httpclient;network;resilience;polly;ratelimit</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CKN.Sdk.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CKN.Sdk.Core\CKN.Sdk.Core.csproj" />
    <ProjectReference Include="..\CKN.Sdk.Network\CKN.Sdk.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
