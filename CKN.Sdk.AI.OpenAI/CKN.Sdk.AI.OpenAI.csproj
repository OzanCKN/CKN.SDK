<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CKN.Sdk.AI.OpenAI</PackageId>
    <Description>OpenAI (ChatGPT) provider for CKN.Sdk.AI. Registers IChatClient via Microsoft.Extensions.AI.OpenAI.</Description>
    <PackageTags>ckn;sdk;ai;openai;chatgpt;llm</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CKN.Sdk.Core\CKN.Sdk.Core.csproj" />
    <ProjectReference Include="..\CKN.Sdk.AI\CKN.Sdk.AI.csproj" />
  </ItemGroup>

</Project>
