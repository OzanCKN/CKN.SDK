<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>CKN.Sdk.Financial</AssemblyName>
    <RootNamespace>CKN.Sdk.Financial</RootNamespace>
    <PackageId>CKN.Sdk.Financial</PackageId>
    <Title>CKN SDK — Financial</Title>
    <Description>Provider-agnostic financial utilities for .NET: market calendars (BIST, NYSE, NASDAQ, Crypto), OHLC bar aggregation, and portfolio math (WAC, PnL, ROI). Zero third-party dependencies.</Description>
    <PackageTags>finance;market-calendar;ohlc;portfolio;bist;nyse;nasdaq;crypto;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CKN.Sdk.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CKN.Sdk.Core\CKN.Sdk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
