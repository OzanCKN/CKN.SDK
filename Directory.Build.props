<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)ckn.snk</AssemblyOriginatorKeyFile>
    <Authors>CKN Teknoloji</Authors>
    <Company>CKN</Company>
    <Description>Enterprise Architecture module for $(MSBuildProjectName). Provides core SDK functionality for the CKN ecosystem.</Description>
    <RepositoryUrl>https://github.com/OzanCKN/CKN.SDK</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);CS1591;SKEXP0010;IL2026;IL3050;IL2075;NU1902;NU1903;NU1904;NU1506;CS0105;CS8629;IL2091;NU1605;NU1603;NU1510;NU1511</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    
    <!-- SourceLink and Debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- AOT Compatibility baseline -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Include README and Tools in all packages -->
  <ItemGroup>
    <!-- Proje dizininde README.md varsa onu paketle, yoksa ana dizindekini paketle -->
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="!Exists('README.md')" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
